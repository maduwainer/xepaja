# Copie para .env e ajuste. .env nunca vai para o git.
# Local: basta DATABASE_URL* apontando para o compose (defaults ja batem).
DATABASE_URL=postgres://xepaja:xepaja-dev@localhost:5432/xepaja
DATABASE_URL_TEST=postgres://xepaja:xepaja-dev@localhost:5432/xepaja_test

# Postgres do compose (db e app usam as mesmas chaves).
POSTGRES_USER=xepaja
POSTGRES_PASSWORD=xepaja-dev
POSTGRES_DB=xepaja
POSTGRES_PORT=5432
APP_PORT=3000

# Local: a API e o seed usam o localhost abaixo (sem dominio, sem Caddy).
XEPAJA_URL=http://localhost:3000
COOKIE_SECURE=0

# Demo/prod na VPS (compose.prod.yaml): dominio com DNS para a VPS.
# XEPAJA_URL e a URL publica usada pelo seed e pelos links.
# Troque para o dominio real na VPS:
# DOMAIN=feira.exemplo.com
# XEPAJA_URL=https://feira.exemplo.com
# COOKIE_SECURE=1

# Push e sessoes (opcionais no dev; sem VAPID_* as chaves vao para data/vapid.json).
VAPID_SUBJECT=mailto:xepaja@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SESSION_TTL_DAYS=7
PORT=3000
