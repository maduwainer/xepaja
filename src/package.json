{
  "name": "xepaja",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run tools/build.ts && bun src/api/index.ts",
    "watch": "bun run tools/dev.ts",
    "watch:api": "bun --watch src/api/index.ts",
    "watch:web": "bun build src/web/main.tsx --outdir=public/dist --target=browser --sourcemap=inline --watch",
    "build": "bun run tools/build.ts",
    "seed": "bun tools/seed.ts",
    "test": "XEPAJA_TEST=1 bun tools/reset-test-db.ts && XEPAJA_TEST=1 bun test",
    "db:migrate": "bun src/api/db.ts",
    "check": "bunx tsc --noEmit && echo \"tsc ok\""
  },
  "dependencies": {
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}